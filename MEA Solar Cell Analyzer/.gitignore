# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Built launcher / binaries (rebuilt from source; see LAUNCHER_AND_PACKAGING.md) ---
*.exe
*.o
*.obj
*.res

# --- Diagnostic outputs (regenerated by the verify_*.py scripts; can be large) ---
*_diag.npz
coupling_diag.*
solar_diag.*
filter_diag.*
span_diag.*
stim_diag.*
bio_shape_check.*
# Any other diagnostic artifacts — keep the *.py scripts, drop their outputs:
*.npz

# --- Logs ---
error.log
startup_stderr.log
*.log

# --- Per-machine runtime state (persisted GUI settings: chosen data/spike dirs,
#     absolute paths). Machine-specific, not source. Force-add if you ever want to
#     track a project's saved cell placements. ---
settings.json
mea_*_settings.json

# --- Figures emitted at runtime (the app writes these to Output/Filtered Signal; a few land here) ---
# Keep committed reference images out; ignore ad-hoc test renders:
plat_test.png
annot_test*.png

# --- OS / editor cruft ---
desktop.ini
Thumbs.db
.DS_Store
.vscode/
.idea/

# --- Data: never commit raw recordings (hundreds of MB) ---
*.h5
*.hdf5
*.mat

# NOTE: this folder is Nextcloud-synced. If git/Nextcloud fight over .git,
# add ".git/" to Nextcloud's ignore list rather than deleting the repo.
